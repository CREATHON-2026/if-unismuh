# Salin berkas ini jadi .env lalu isi nilainya.
# JANGAN pernah commit .env — sudah ada di .gitignore.

# LLM: Ollama kampus. TIDAK butuh kunci API — nilai bawaan sudah benar,
# jadi baris ini boleh dikosongkan atau dihapus sama sekali.
OLLAMA_URL=https://ollama.if.unismuh.ac.id
OLLAMA_MODEL=gemma4:latest

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/lapakai

# Rahasia untuk menandatangani token sesi (bebas, asal panjang dan acak)
JWT_SECRET=

# Mode demo: kalau true, OTP tidak benar-benar dikirim dan kodenya selalu 123456
# Lihat docs/08-keamanan-data.md
DEMO_MODE=true

# Port server backend
PORT=3000

# ---------------------------------------------------------------------------
# Midtrans â€” QRIS untuk pesanan (OPSIONAL)
#
# Kosongkan saja kalau belum perlu: tombol QRIS otomatis disembunyikan, dan
# tunai/transfer/kasbon tetap jalan. Alur inti TIDAK bergantung pada ini.
#
# âš  Kunci berawalan `Mid-`    = PRODUCTION, menagih UANG SUNGGUHAN.
#    Kunci berawalan `SB-Mid-` = sandbox, aman untuk uji coba.
#
# MIDTRANS_PRODUKSI harus diisi 'true' SECARA SENGAJA. Selama tidak diisi,
# server memakai alamat sandbox â€” jadi kunci production akan ditolak 401 dan
# tidak ada satu rupiah pun yang bisa berpindah karena salah konfigurasi.
# ---------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUKSI=false
