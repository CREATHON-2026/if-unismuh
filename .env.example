# Salin berkas ini jadi .env lalu isi nilainya.
# JANGAN pernah commit .env — sudah ada di .gitignore.

# LLM: Ollama kampus. TIDAK butuh kunci API — nilai bawaan sudah benar,
# jadi baris ini boleh dikosongkan atau dihapus sama sekali.
OLLAMA_URL=https://ollama.if.unismuh.ac.id
OLLAMA_MODEL=gemma4:latest

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/lapakai

# Rahasia untuk menandatangani token sesi (bebas, asal panjang dan acak)
JWT_SECRET=

# Mode demo: kalau true, OTP tidak benar-benar dikirim dan kodenya selalu 123456
# Lihat docs/08-keamanan-data.md
DEMO_MODE=true

# Port server backend
PORT=3000
